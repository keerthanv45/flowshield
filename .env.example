# FlowShield — environment variable template
# Copy to `.env` and fill in real values locally. Never commit `.env`.
#
# Nothing in Phase 1 actually reads these yet — they are placeholders for
# the provider abstraction and Razorpay integration built in later phases.

# --- App -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO


# --- LLM reasoning provider -------------------------------------------
REASONING_PROVIDER=mock

# NVIDIA Nemotron
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Future: Razorpay integration --------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Future: database ---------------------------------------------------
# DATABASE_URL=
