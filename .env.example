# FlowShield — environment variable template
# Copy to `.env` and fill in real values locally. Never commit `.env`.
#
# Nothing in Phase 1 actually reads these yet — they are placeholders for
# the provider abstraction and Razorpay integration built in later phases.

# --- App -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

